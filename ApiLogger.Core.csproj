<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- รองรับ .NET 8 / 9 / 10 -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet package info -->
    <PackageId>ApiLogger.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>YourCompany</Authors>
    <Description>
      Background API logging package. Captures incoming requests (Middleware)
      and outgoing requests (DelegatingHandler), then sends them to a central
      Log API (CreateLog) asynchronously without blocking the caller.
    </Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
